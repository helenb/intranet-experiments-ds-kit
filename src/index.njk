{% from "components/list/_macro.njk" import onsList %}

{% set pageConfig = {
    "wide": true,
    "title": "ONS Prototypes",
    "footer": {
        "oglLink": true
    }
} %}
{% block mainContent %}
    {% set groups = helpers.navigationHelper({
        "pages": prototypeListing,
        "ignorePaths": ["/"]
    }) %}
    <div class="ons-u-container ons-u-container--wide">
    <div class="ons-grid">
        <div class="ons-grid__col ons-col-4@m">
            Demo of sidebar
        </div>
        <div class="ons-grid__col ons-col-8@m">
            {% for group in groups %}
                <section>
                    <h1 class="u-fs-m">{{ group.title }}</h1>
                    {{
                        onsList({
                            "classes": "ons-list--bare",
                            "itemsList": group.items
                        })
                    }}
                </section>
            {% endfor %}
        </div>
{% endblock %}
